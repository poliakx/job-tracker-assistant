datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ApplicationStatus {
  applied
  interview
  technical_task
  offer
  no_answer
  rejected
}

enum ApplicationSource {
  linkedin
  justjoinit
  nofluffjobs
  pracuj
  company_website
  other
  // Added for Phase 7: a Vacancy promoted into an Application records its
  // real source instead of being mislabeled "other".
  theprotocol
}

model JobApplication {
  id            String            @id @default(cuid())
  company       String
  position      String
  jobUrl        String?
  status        ApplicationStatus
  source        ApplicationSource
  appliedDate   DateTime
  followUpDate  DateTime?
  contactPerson String?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // set once a Vacancy is promoted into an application (see Vacancy.applicationId)
  vacancy Vacancy?
}

enum VacancyStatus {
  NEW
  SHORTLISTED
  DISMISSED
  APPLIED
}

enum SuggestedResume {
  FULLSTACK
  BACKEND
  FRONTEND
}

// A vacancy found by the ingestion pipeline, not yet (or not ever) an Application.
// Kept separate from JobApplication: most vacancies are dismissed and never applied to.
model Vacancy {
  id          String    @id @default(cuid())
  source      String
  externalId  String
  url         String
  title       String
  company     String
  location    String?
  remote      Boolean?
  description String
  postedAt    DateTime?
  fetchedAt   DateTime  @default(now())

  status          VacancyStatus    @default(NEW)
  fitScore        Int?
  analysis        Json?
  suggestedResume SuggestedResume?

  // Output of the cheap rule filter (lib/filter.ts): string[], or null
  // until the filter has run. Not the same as `analysis` (Phase 5's LLM
  // output) — this is fast/free heuristics, always shown even for
  // vacancies the filter didn't dismiss.
  filterReasons Json?

  applicationId String?         @unique
  application   JobApplication? @relation(fields: [applicationId], references: [id])

  resume Resume?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@index([status, fitScore])
}

// The candidate profile that drives lib/filter.ts and lib/analyze.ts's
// prompts. A singleton row (id is always "default") so there's exactly one
// live profile, editable via the Phase-9 AI interview at /profile. `data`
// mirrors lib/profile.ts's CandidateProfile shape; that file's hardcoded
// object becomes the seed/fallback used before this row is ever created.
model Profile {
  id        String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A generated resume (text sections only — contact details are rendered
// from Profile at view time). vacancyId null = the base resume; set = a
// version tailored to that vacancy, deleted along with it.
model Resume {
  id        String   @id @default(cuid())
  vacancyId String?  @unique
  vacancy   Vacancy? @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  // ResumeContent (types/index.ts)
  content   Json
  // string[]: what a tailored version changed vs. the profile, and why
  changes   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One completed English test (/english). The latest one feeds the match
// analysis and the resume's languages section.
model EnglishAssessment {
  id           String   @id @default(cuid())
  overallLevel String
  // EnglishAssessmentResult (types/index.ts)
  result       Json
  // QuizScore (types/index.ts)
  quizScore    Json
  createdAt    DateTime @default(now())
}

// One execution of the ingest → filter → analyze pipeline, for observability.
model PipelineRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  source     String
  fetched    Int       @default(0)
  newCount   Int       @default(0)
  analyzed   Int       @default(0)
  errors     Json?

  // { triageInputTokens, triageOutputTokens, deepInputTokens, deepOutputTokens }
  tokenUsage Json?
}

// The kinds of source a user can add from /sources without writing code.
// Only formats a site publishes *for* automated reading: public job-board
// APIs of applicant tracking systems, RSS/Atom feeds, and schema.org
// JobPosting data. There is deliberately no "any HTML page" kind.
enum SourceKind {
  greenhouse
  lever
  ashby
  rss
  jsonld
}

// A job source configured in the UI (/sources). Built into a VacancySource
// at run time by backend/sources/configured.ts; code adapters in
// backend/sources/index.ts don't have a row here.
model SourceConfig {
  id         String     @id @default(cuid())
  kind       SourceKind
  // A board slug (greenhouse/lever/ashby) or an https URL (rss/jsonld).
  identifier String
  label      String
  enabled    Boolean    @default(true)

  // Why this source may be read automatically, recorded by whoever added
  // it: the terms page they checked and what it says. Required — the UI
  // won't save a source without them.
  termsUrl         String
  termsNote        String
  termsConfirmedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, identifier])
}
