# Copy this file to .env and set your PostgreSQL connection string.
# Example DATABASE_URL for a local Postgres container:
# DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Server-side only — never exposed to client code. From console.anthropic.com.
ANTHROPIC_API_KEY=

# Verifies requests to the cron/ingest endpoint (Phase 6). Any random string.
CRON_SECRET=

# Cheap yes/no triage runs on every filtered vacancy; the more expensive deep
# analysis only runs on the ones that pass triage.
ANALYSIS_MODEL_TRIAGE=claude-haiku-4-5-20251001
ANALYSIS_MODEL_DEEP=claude-sonnet-5

# Upper bound on deep analyses per calendar day, to keep API cost bounded.
ANALYSIS_DAILY_CAP=50

# Automated vacancy collection (job-board sources, the cron endpoint, the
# search API) is off unless this is "true". Vacancies are added by hand.
SCRAPING_ENABLED=false

# Comma-separated job-board source names to switch off (see
# backend/sources/index.ts), e.g. DISABLED_SOURCES=greenhouse,lever
DISABLED_SOURCES=

# Contact address sent in the scraper User-Agent so site owners can reach
# you (docs/PLAN.md rule 9). Kept out of the code so it is not published.
SCRAPER_CONTACT_EMAIL=you@example.com
